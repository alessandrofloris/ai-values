# ----------------------------------------------------------------------------
# Standard Cloud Providers API Keys
# ----------------------------------------------------------------------------
# Format: {PROVIDER}_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
FIREWORKS_API_KEY=
QWEN_API_KEY=

# ----------------------------------------------------------------------------
# Custom OpenAI-compatible Endpoint Standard (Local or Private Server)
# ----------------------------------------------------------------------------
# Used when an experiment in config/experiments.json sets:
#   "provider": "custom_openai"
#
# Base URL of the OpenAI-compatible server (e.g. vLLM, Ollama, LM Studio, custom proxy)
CUSTOM_OPENAI_BASE_URL=http://localhost:8000/v1

# API Key (optional for some local engines; dummy key is used if left blank)
CUSTOM_OPENAI_API_KEY=dummy-key

# Default model name passed to the endpoint (if "model": "default" in experiments.json)
CUSTOM_OPENAI_MODEL=default

# Concurrency: max parallel experiment workers (default: 6 or value below)
CUSTOM_OPENAI_CONCURRENCY=8

# Request timeout in seconds (default: 120)
CUSTOM_OPENAI_REQUEST_TIMEOUT=120

# Max retries for requests and short answer nudging (default: 5)
CUSTOM_OPENAI_MAX_RETRIES=5

